<!DOCTYPE html>
<html>
<head>
  <title>Todo App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">

  <h2>Todo List</h2>

  <!-- Form thêm task -->
  <form action="/add" method="POST" class="d-flex mb-3">
    <input type="text" name="title" class="form-control me-2" placeholder="Nhập công việc..." required>
    <button class="btn btn-primary">Thêm</button>
  </form>

  <!-- Progress -->
  <div class="progress mb-3">
    <div class="progress-bar bg-success"
         role="progressbar"
         style="width:<%= percent %>%">
      <%= percent %>%
    </div>
  </div>

  <!-- Danh sách task -->
  <ul class="list-group">
    <% tasks.forEach(task => { %>
      <li class="list-group-item d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-2">
          
          <!-- Checkbox hoàn thành -->
          <form action="/toggle/<%= task._id %>" method="POST">
            <input type="checkbox"
                   onchange="this.form.submit()"
                   <%= task.isDone ? "checked" : "" %>>
          </form>

          <!-- Title -->
          <span class="<%= task.isDone ? 'text-decoration-line-through text-muted' : '' %>">
            <%= task.title %>
          </span>

        </div>

        <!-- Delete -->
        <form action="/delete/<%= task._id %>" method="POST">
          <button class="btn btn-danger btn-sm">Xóa</button>
        </form>

      </li>
    <% }) %>
  </ul>

</body>
</html>