<!DOCTYPE html>
<html>
<head>
  <title>Todo App - Level 3</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

  <h2 class="mb-4">Todo List - Level 3 (Phân quyền)</h2>

  <!-- ================= AUTH STATUS ================= -->
  <% if (currentUser) { %>
    <div class="alert alert-info d-flex justify-content-between align-items-center">
      <span>Xin chào, <strong><%= currentUser.fullname %></strong> (Role: <%= currentUser.role %>)</span>
      <a href="/api/users/logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
    </div>
  <% } else { %>
    <div class="alert alert-warning">
      Bạn chưa đăng nhập. <a href="/api/users/login">Đăng nhập tại đây</a> để sử dụng chức năng phân quyền.
    </div>
  <% } %>

  <!-- ================= ADMIN ONLY ================= -->
  <% if (currentUser && currentUser.role === "admin") { %>

  <div class="card mb-4">
    <div class="card-body">

      <h5 class="mb-3">Tạo & Phân công Task</h5>

      <form action="/v3/assign" method="POST">

        <div class="mb-3">
          <label class="form-label">Tên công việc</label>
          <input type="text" name="title" class="form-control" required>
        </div>

        <!-- createdBy = admin hiện tại -->
        <input type="hidden" name="createdBy" value="<%= currentUser._id %>">

        <div class="mb-3">
          <label class="form-label">Phân công cho (chỉ user normal)</label>
          <select name="userIds" multiple class="form-select" required>
            <% users.forEach(user => { %>
              <% if (user.role === "normal") { %>
                <option value="<%= user._id %>">
                  <%= user.fullname %>
                </option>
              <% } %>
            <% }) %>
          </select>
          <small class="text-muted">Giữ Ctrl để chọn nhiều</small>
        </div>

        <button class="btn btn-primary">Tạo & Phân công</button>

      </form>

    </div>
  </div>

  <% } %>
  <!-- ================= END ADMIN ================= -->


  <!-- ================= TASK LIST ================= -->

  <% tasks.forEach(task => { %>

    <% 
      const total = task.assignedUsers.length;
      const done = task.assignedUsers.filter(u => u.isDone).length;
      const percent = total === 0 ? 0 : Math.round((done / total) * 100);
    %>

    <div class="card mb-4">
      <div class="card-body">

        <h5><%= task.title %></h5>

        <p class="text-muted">
          Created by: <%= task.createdBy?.fullname || "Unknown" %>
        </p>

        <!-- Progress -->
        <div class="progress mb-3" style="height:20px;">
          <div class="progress-bar <%= percent === 100 ? 'bg-success' : 'bg-warning' %>"
               style="width:<%= percent %>%">
            <%= percent %>%
          </div>
        </div>

        <h6>Assigned Users:</h6>

        <% task.assignedUsers.forEach(au => { %>

          <div class="ms-3 mb-2 d-flex justify-content-between align-items-center">

            <div>
              <strong><%= au.user.fullname %></strong>

              <% if (au.isDone) { %>
                <span class="text-success">
                  ✅ Done at <%= new Date(au.doneAt).toLocaleString() %>
                </span>
              <% } else { %>
                <span class="text-danger">❌ Not Done</span>
              <% } %>
            </div>

            <!-- ===== NORMAL chỉ complete phần của mình ===== -->
            <% if (
              !au.isDone &&
              currentUser &&
              au.user._id.toString() === currentUser._id.toString()
            ) { %>

              <form action="/v3/complete/<%= task._id %>" method="POST">
                <input type="hidden" name="userId" value="<%= currentUser._id %>">
                <button class="btn btn-sm btn-success">
                  Complete
                </button>
              </form>

            <% } %>

          </div>

        <% }) %>

        <% if (task.isCompleted) { %>
          <div class="alert alert-success mt-3">
            🎉 Task hoàn thành!
          </div>
        <% } %>

      </div>
    </div>

  <% }) %>

</body>
</html>